{
	"name": "obsidian-inference-machine",
	"version": "0.1.0",
	"description": "Derive a new note from an existing one with an AI model, using reusable templates, engines and tagging rules.",
	"main": "main.js",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint .",
		"test": "vitest run --coverage",
		"test:watch": "vitest",
		"vault": "obsidian-launcher watch --copy --plugin . test/vault"
	},
	"keywords": [
		"obsidian",
		"plugin",
		"ai",
		"llm",
		"templates"
	],
	"author": "Corey Struzan",
	"license": "MIT",
	"engines": {
		"node": ">=20"
	},
	"dependencies": {
		"@codemirror/lang-markdown": "6.5.2",
		"knap": "0.6.0"
	},
	"devDependencies": {
		"@codemirror/commands": "6.11.1",
		"@codemirror/language": "6.13.1",
		"@codemirror/state": "6.7.6",
		"@codemirror/view": "6.43.13",
		"@eslint/js": "9.39.5",
		"@types/node": "22.20.5",
		"@vitest/coverage-v8": "5.0.5",
		"esbuild": "0.28.2",
		"eslint": "9.39.5",
		"eslint-plugin-obsidianmd": "0.4.2",
		"fast-check": "4.10.2",
		"globals": "17.13.0",
		"jiti": "2.7.0",
		"obsidian": "1.14.4",
		"obsidian-launcher": "3.3.0",
		"typescript": "6.0.3",
		"typescript-eslint": "8.71.2",
		"vitest": "5.0.5",
		"yaml": "2.9.1"
	}
}
